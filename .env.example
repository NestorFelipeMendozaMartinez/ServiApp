# Variables de entorno para despliegue

# Clave secreta de Django
DJANGO_SECRET_KEY=tu_clave_secreta_aqui

# DEBUG en producción debe ser False
DJANGO_DEBUG=False

# Dominios permitidos separados por comas
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# URL de base de datos PostgreSQL en producción
# Ejemplo: postgres://usuario:password@host:5432/nombre_basedatos
DATABASE_URL=postgres://usuario:password@localhost:5432/servicios_db
